# ManageSim Environment Variables
# Copy this to .env and fill in your values

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Discord Bot Tokens
DISCORD_BOT_TOKEN_PERSONAL=your-personal-assistant-bot-token
DISCORD_BOT_TOKEN_ASSET=your-asset-base-bot-token

# Add project bot tokens as needed:
# DISCORD_BOT_TOKEN_PROJECT_ALPHA=...
# DISCORD_BOT_TOKEN_PROJECT_BETA=...

# Easybase
EASYBASE_DIR=~/.easybase

# Mem0 (optional, defaults to local)
MEM0_STORAGE=local
MEM0_LOCAL_PATH=./data/mem0
